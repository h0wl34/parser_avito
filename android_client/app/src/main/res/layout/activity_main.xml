<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avito Push Bridge"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/notification_access_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="1. Дать доступ к уведомлениям" />

        <Button
            android:id="@+id/battery_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Настройки батареи / фоновой работы" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Пакеты приложений (через запятую или пробел)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/packages_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.avito.android"
            android:inputType="textNoSuggestions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="HTTPS endpoint сервера"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/endpoint_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com/phone-notification"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Shared secret (хранится через Android Keystore)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/secret_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="случайная строка, одинаковая с сервером" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Сохранить настройки" />

        <Button
            android:id="@+id/test_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить тестовое событие и отправить" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Обновить" />

            <Button
                android:id="@+id/copy_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Копировать последний JSON" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Последние события"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/events_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
