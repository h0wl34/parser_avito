# Production-safe acquisition sources for Laptop Deal Watcher.
# Sources only ingest listing events. The durable queue lives in database.db;
# deal_feed_runner.py consumes that queue and performs scoring/notifications.

[jsonl]
# Optional generic/manual adapter. Complete JSONL lines are checkpointed and
# copied into the durable SQLite queue. Partial final writes are never consumed.
enabled = true
path = "deal_feed.jsonl"
poll_seconds = 2
start_at_end = false

[webhook]
# Optional high-speed ingress for Avigram's documented callback API.
# Webhook events are committed DIRECTLY to the SQLite queue before HTTP 202 is
# returned; JSONL is not required for webhook durability.
#
# Keep this bound to localhost and expose it through a TLS reverse proxy. The
# callback secret is read from AVIGRAM_CALLBACK_SECRET, never from this file.
enabled = false
provider = "avigram"
bind_host = "127.0.0.1"
port = 8765
path = "/avigram-callback"
require_signature = true
secret_env = "AVIGRAM_CALLBACK_SECRET"
max_skew_seconds = 300
max_body_bytes = 1048576
# Name searches like fast-any-4070 / market-new-4070. Searches whose name
# begins with one of these prefixes become silent MARKET baseline events.
market_name_prefixes = ["market-", "market_", "market "]

[imap]
# Optional fallback: ingest listing links from saved-search notification emails.
# Credentials are NEVER stored here; set the named environment variables.
# Email is marked Seen only after all parsed candidates are committed to SQLite.
enabled = false
host = "imap.example.com"
port = 993
folder = "INBOX"
poll_seconds = 60
sender_contains = "avito"
username_env = "AVITO_MAIL_USER"
password_env = "AVITO_MAIL_PASSWORD"
profile = "imap-fast"
mode = "fast"
mark_seen = true

# Generic JSONL event format:
# {"id": 1234567890, "title": "Lenovo Legion RTX 4070", "price": 99000,
#  "url": "https://www.avito.ru/moskva/noutbuki/..._1234567890",
#  "description": "optional", "profile": "fast-any-4070", "mode": "fast",
#  "source": "my-feed", "published_at": "2026-09-14T09:30:00+03:00"}
#
# mode="market": silent observation eligible for the dynamic market baseline.
# mode="fast": can trigger Telegram when score >= notify_score.
#
# Once webhook/IMAP is your real source, JSONL may be disabled. Keeping it
# enabled is useful for manual smoke tests and custom integrations.
