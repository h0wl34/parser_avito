# Copy to ~/parser_avito/.env.deal-relay on the VPS and chmod 600.
# Use a SEPARATE Telegram bot for system alerts so an invalid/blocked primary
# deal bot does not also destroy the emergency notification path.

DEAL_RELAY_SECRET=CHANGE_ME
DEAL_RELAY_BOT_TOKEN=CHANGE_ME
DEAL_RELAY_CHAT_ID=CHANGE_ME

# Bind relay locally. The main watcher server reaches it through an SSH local
# forward, so no public relay port is required.
DEAL_RELAY_BIND_HOST=127.0.0.1
DEAL_RELAY_PORT=8770

# External watchdog target: private reverse SSH tunnel to the main webhook
# ingress. This catches main-server, tunnel, ingress, and health-monitor failure
# without exposing /healthz to the public Internet.
DEAL_WATCHDOG_URL=http://127.0.0.1:18765/healthz
DEAL_WATCHDOG_INTERVAL=30
DEAL_WATCHDOG_FAILURES=3
DEAL_WATCHDOG_REPEAT=21600
