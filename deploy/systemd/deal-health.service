[Unit]
Description=Laptop Deal Watcher health monitor
Wants=network-online.target deal-relay-tunnel.service
After=network-online.target
After=deal-feed.service deal-relay-tunnel.service

[Service]
Type=simple
WorkingDirectory=%h/parser_avito
EnvironmentFile=-%h/parser_avito/.env.deal-watcher
ExecStart=%h/parser_avito/.venv-avito/bin/python %h/parser_avito/deal_health_monitor.py
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=default.target
