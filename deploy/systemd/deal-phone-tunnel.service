[Unit]
Description=Laptop Deal Watcher Android phone reverse SSH tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/parser_avito
EnvironmentFile=-%h/parser_avito/.env.deal-watcher
ExecStart=/usr/bin/env bash %h/parser_avito/deploy/deal-phone-tunnel.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=default.target
