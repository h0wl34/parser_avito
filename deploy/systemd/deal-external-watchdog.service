[Unit]
Description=Laptop Deal Watcher external watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/parser_avito
EnvironmentFile=-%h/parser_avito/.env.deal-relay
ExecStart=%h/parser_avito/.venv-avito/bin/python %h/parser_avito/deal_external_watchdog.py
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=default.target
