# Copy to ~/parser_avito/.env.deal-watcher and chmod 600.
# Never commit the real file.

# HMAC secret configured on the Avigram callback/search.
AVIGRAM_CALLBACK_SECRET=CHANGE_ME

# Independent emergency alert relay running on the VPS host, outside the SOCKS
# container. The main server reaches it through a persistent SSH local forward,
# so the relay itself does not need a public Internet port.
DEAL_ALERT_RELAY_URL=http://127.0.0.1:18770/alert
DEAL_ALERT_RELAY_SECRET=CHANGE_ME

# Persistent SSH tunnel to the VPS relay.
DEAL_RELAY_SSH_HOST=CHANGE_ME
DEAL_RELAY_SSH_USER=root
DEAL_RELAY_SSH_KEY=/home/YOUR_USER/.ssh/deal_relay_ed25519
DEAL_RELAY_LOCAL_PORT=18770
DEAL_RELAY_REMOTE_PORT=8770

# Optional IMAP fallback only if [imap].enabled=true in deal_sources.toml.
# AVITO_MAIL_USER=CHANGE_ME
# AVITO_MAIL_PASSWORD=CHANGE_ME
