# Copy to ~/parser_avito/.env.deal-watcher and chmod 600.
# Never commit the real file.

# Legacy Avigram callback HMAC secret. Only needed when the Avigram webhook
# source is intentionally enabled.
AVIGRAM_CALLBACK_SECRET=CHANGE_ME

# Android Avito Push Bridge. Use a dedicated random secret; do not reuse bot,
# relay, SSH, or Avito credentials.
DEAL_PHONE_SECRET=CHANGE_ME
DEAL_PHONE_BIND_HOST=127.0.0.1
DEAL_PHONE_PORT=8767
# Optional; these default to the existing relay VPS/SSH settings when omitted.
# DEAL_PHONE_SSH_HOST=CHANGE_ME
# DEAL_PHONE_SSH_USER=root
# DEAL_PHONE_SSH_KEY=/home/YOUR_USER/.ssh/deal_relay_ed25519
# DEAL_PHONE_REMOTE_PORT=18767
# DEAL_PHONE_LOCAL_PORT=8767

# Independent emergency alert relay running on the VPS host, outside the SOCKS
# container. The main server reaches it through a persistent SSH local forward,
# so the relay itself does not need a public Internet port.
DEAL_ALERT_RELAY_URL=http://127.0.0.1:18770/alert
DEAL_ALERT_RELAY_SECRET=CHANGE_ME

# Persistent SSH tunnel to the VPS relay.
DEAL_RELAY_SSH_HOST=CHANGE_ME
DEAL_RELAY_SSH_USER=root
DEAL_RELAY_SSH_KEY=/home/YOUR_USER/.ssh/deal_relay_ed25519
DEAL_RELAY_LOCAL_PORT=18770
DEAL_RELAY_REMOTE_PORT=8770

# Optional reverse SSH tunnel for the legacy provider webhook path.
# DEAL_WEBHOOK_SSH_HOST=CHANGE_ME
# DEAL_WEBHOOK_SSH_USER=root
# DEAL_WEBHOOK_SSH_KEY=/home/YOUR_USER/.ssh/deal_relay_ed25519
# DEAL_WEBHOOK_REMOTE_PORT=18765
# DEAL_WEBHOOK_LOCAL_PORT=8765

# Optional IMAP fallback only if [imap].enabled=true in deal_sources.toml.
# AVITO_MAIL_USER=CHANGE_ME
# AVITO_MAIL_PASSWORD=CHANGE_ME
